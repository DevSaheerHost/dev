# @firebase/rules-unit-testing@5 declares a peer of firebase@^12 and has not
# been republished for firebase@13, which this app uses. The two are compatible
# in practice — the test helper only talks to the emulator — but npm refuses the
# tree without this flag, which makes `npm install` and `npm ci` behave
# differently on a developer's machine and in CI depending on which flags were
# remembered. Pinning it here makes the install reproducible.
legacy-peer-deps=true
