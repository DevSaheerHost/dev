# Firebase web configuration for My Work Ledger (project: my-web-b35e3).
#
# These values are committed on purpose. They are not credentials: the Firebase
# client SDK ships them inside every browser bundle, and this repository already
# serves that bundle publicly, so hiding the file would conceal nothing while
# making a rebuild from a fresh clone impossible.
#
# What actually protects the data:
#   1. firebase/firestore.rules  - every document is scoped to request.auth.uid.
#   2. Email/Password sign-in with self-signup disabled once the account exists.
#   3. An API key restricted to this app's referrers in the Google Cloud console.
#   4. App Check, when VITE_FIREBASE_APPCHECK_SITE_KEY is set.
#
# Admin SDK / service-account credentials are a different matter entirely and
# must never appear in this file, this folder, or any client bundle.

VITE_FIREBASE_API_KEY=AIzaSyAyORnyU9YAO69onN6th5LQU8fDTPTuETQ
VITE_FIREBASE_AUTH_DOMAIN=my-web-b35e3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=my-web-b35e3
VITE_FIREBASE_STORAGE_BUCKET=my-web-b35e3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=623340786402
VITE_FIREBASE_APP_ID=1:623340786402:web:0425c2d876be38e8d744bb
