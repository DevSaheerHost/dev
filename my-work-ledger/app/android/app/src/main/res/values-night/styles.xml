<?xml version="1.0" encoding="utf-8"?>
<!--
  In dark mode the bars are dark, so their icons have to be light. These two
  flags are the opposite of the ones in `values/styles.xml`; without the
  override the status bar icons stay dark and vanish against the background.
-->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/wl_bg</item>
        <item name="android:navigationBarColor">@color/wl_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
