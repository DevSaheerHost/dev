{
  "name": "my-work-ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal multi-shop salary, income and expense ledger.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/publish.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:static": "node scripts/publish.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "emulator": "firebase emulators:start --only firestore --project demo-ledger --config ../firebase.json"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
