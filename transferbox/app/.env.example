# Firebase web configuration.
#
# These values identify the project to the Firebase client SDK. They are shipped
# in every browser bundle and are NOT secrets — the security boundary is the
# Realtime Database and Storage rules in /transferbox/firebase, not this file.
# Service-account credentials (Admin SDK) must never appear here.
#
# Copy to `.env.local` for development, and set the same variables in your
# hosting provider for production builds.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Realtime Database URL. Optional: when omitted the app derives
# https://<project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
