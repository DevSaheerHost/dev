{
  "name": "transferbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-to-browser sharing for text and files. No accounts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/publish.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:static": "node scripts/publish.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
