rules_version = '2';

// StockPilot accesses Firestore ONLY from its Next.js server using the Admin
// SDK, which bypasses these rules after the server has verified the user's
// session, business membership and role. Browsers and mobile clients get no
// direct access at all: every read and write is denied here, so a leaked web
// API key or a malicious client cannot touch tenant data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
