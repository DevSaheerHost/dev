# ─────────────────────────────────────────────────────────────────────────────
# StockPilot AI — environment variables (Firebase edition)
# Copy to .env.local for development. NEVER commit real values.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase web config (required) ───────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app.
# These identify the project; they are not secrets. Data is protected by the
# server (all Firestore/Storage access goes through it; rules deny browsers).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public base URL of this deployment (invitation links, OAuth redirects, webhooks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Firebase Admin (server only) ─────────────────────────────────────────────
# On Firebase App Hosting / Cloud Run these are not needed (default service
# account). On Vercel or elsewhere, create a service account key:
# Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=
# Paste the key with literal \n for newlines, wrapped in quotes.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ── Local development with the Firebase emulators (optional) ─────────────────
# Uncomment to run fully offline: `npx firebase emulators:start --project demo-stockpilot`
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── AI (optional, recommended) ───────────────────────────────────────────────
# "local"  = built-in rule parser for voice (no photos, no server transcription)
# "gemini" = Gemini for voice understanding, photo recognition and transcription
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Security ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts POS OAuth tokens at rest (AES-256-GCM).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Email notifications & purchase orders (optional) ─────────────────────────
RESEND_API_KEY=
EMAIL_FROM="StockPilot <alerts@your-domain.com>"

# ── WhatsApp Business Cloud API (optional) ───────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Web push (optional) — npx web-push generate-vapid-keys ────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com

# ── POS integrations (optional) ──────────────────────────────────────────────
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=sandbox
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_WEBHOOK_AUTH_CODE=
CLOVER_ENVIRONMENT=sandbox
