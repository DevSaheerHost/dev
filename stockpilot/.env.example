# ─────────────────────────────────────────────────────────────────────────────
# StockPilot AI — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Only NEXT_PUBLIC_* values reach the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project URL and the publishable (anon) key. RLS protects all data, so this
# key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (service role) key. Server-only: rate limiting, webhooks, cron, POS
# credentials. Bypasses RLS — never expose it. (SUPABASE_SERVICE_ROLE_KEY also accepted.)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public base URL of this deployment (OAuth redirects, invitation links, webhooks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI (optional, recommended) ───────────────────────────────────────────────
# "local"  = built-in rule parser for voice (no photos, no server transcription)
# "gemini" = Gemini for voice understanding, photo recognition and transcription
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Security ─────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Encrypts POS OAuth tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Email notifications & purchase orders (optional) ─────────────────────────
RESEND_API_KEY=
EMAIL_FROM="StockPilot <alerts@your-domain.com>"

# ── WhatsApp Business Cloud API (optional) ───────────────────────────────────
# Without these, purchase orders still open a prefilled wa.me link.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Web push (optional) ──────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com

# ── POS: Square (optional) ───────────────────────────────────────────────────
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_ENVIRONMENT=sandbox

# ── POS: Shopify (optional) ──────────────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ── POS: Clover (optional) ───────────────────────────────────────────────────
CLOVER_APP_ID=
CLOVER_APP_SECRET=
# Verification code Clover sends once when you register the webhook URL
# (it is printed in the server log on first delivery).
CLOVER_WEBHOOK_AUTH_CODE=
CLOVER_ENVIRONMENT=sandbox
